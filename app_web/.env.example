# Copiar a .env.local y rellenar con las claves reales del proyecto Supabase
# (Project Settings -> API). Nunca commitear .env.local ni pegar estas claves
# en el chat.

# URL del proyecto y clave anon: seguras para el navegador (prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SOLO servidor (script de siembra / futuras Route Handlers
# de administración). Nunca debe llevar el prefijo NEXT_PUBLIC_ ni llegar al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=
